# Copy this file to .env and fill in real values. Never commit .env itself.

# Required: used by the judge model (candidate critique/ranking + eval scoring).
ANTHROPIC_API_KEY=

# Optional: needed if the policy model (or its fallback) is gated on Hugging Face,
# or if scripts/generate_candidates.py --endpoint-url is used (a hosted HF endpoint).
HF_TOKEN=
